{
	"name": "next-safe-action-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "next-safe-action monorepo",
	"scripts": {
		"pg": "turbo run dev --filter=@apps/playground",
		"lint": "turbo run lint",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"build": "turbo run build",
		"test": "turbo run test",
		"test:lib": "turbo run test --filter=./packages/*",
		"test:pg": "pnpm run build:lib && pnpm run build:pg && pnpm --filter=@apps/playground run test:e2e",
		"lint:lib": "turbo run lint --filter=./packages/*",
		"build:lib": "turbo run build --filter=./packages/* --force",
		"docs": "turbo run dev --filter=@apps/docs",
		"lint:pg": "turbo run lint --filter=@apps/playground",
		"lint:docs": "turbo run lint --filter=@apps/docs",
		"build:pg": "turbo run build --filter=@apps/playground --force",
		"build:docs": "turbo run build --filter=@apps/docs --force",
		"changeset": "changeset",
		"changeset:empty": "changeset --empty",
		"version-packages": "changeset version",
		"release": "changeset publish"
	},
	"author": "Edoardo Ranghieri",
	"license": "MIT",
	"engines": {
		"node": ">=18.17"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/next-safe-action/next-safe-action.git"
	},
	"dependencies": {
		"@manypkg/cli": "^0.25.1",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3"
	},
	"packageManager": "pnpm@11.28.5"
}
