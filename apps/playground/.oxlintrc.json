{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["../../.oxlintrc.base.json"],
	"plugins": ["oxc", "eslint", "unicorn", "typescript", "react", "react-perf", "nextjs"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"typescript/consistent-type-imports": "error",
		"typescript/no-unsafe-type-assertion": "off",
		"react/react-in-jsx-scope": "off"
	},
	"overrides": [
		{
			// Generated by the shadcn CLI (see components.json): keep them identical to upstream.
			"files": ["src/components/ui/**", "src/hooks/**"],
			"rules": {
				"react/purity": "off",
				"react/set-state-in-effect": "off"
			}
		}
	]
}
