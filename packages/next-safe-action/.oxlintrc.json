{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["../../.oxlintrc.base.json"],
	"plugins": ["oxc", "eslint", "unicorn", "typescript", "react", "react-perf"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"typescript/consistent-type-imports": "error",
		"typescript/no-unsafe-type-assertion": "off",
		"unicorn/require-module-specifiers": "off",
		// The hooks read refs during render on purpose: `initResult` is captured once at mount
		// (mirroring `useActionState`), and `useOptimisticStateAction` derives its confirmed value
		// purely from refs that are only written in layout effects, so an abandoned concurrent render
		// never leaks uncommitted state. See the architecture notes in AGENTS.md. Tests also capture
		// hook functions into refs during render.
		"react/refs": "off"
	},
	"overrides": [
		{
			"files": ["src/__tests__/**/*.ts"],
			"rules": {
				"eslint/no-shadow": "off"
			}
		}
	]
}
