{
	"name": "@next-safe-action/adapter-routes",
	"version": "0.1.0",
	"private": false,
	"description": "JSON route handlers and optional OpenAPI for next-safe-action.",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./openapi": {
			"types": "./dist/openapi.d.mts",
			"default": "./dist/openapi.mjs"
		}
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.mts"
			],
			"openapi": [
				"./dist/openapi.d.mts"
			]
		}
	},
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/TheEdoRan"
		},
		{
			"type": "paypal",
			"url": "https://www.paypal.com/donate/?hosted_button_id=ES9JRPSC66XKW"
		}
	],
	"scripts": {
		"test": "vitest run",
		"lint": "tsc --noEmit && oxlint --type-aware .",
		"build": "tsdown"
	},
	"keywords": [
		"next-safe-action",
		"nextjs",
		"routes",
		"openapi"
	],
	"author": "Edoardo Ranghieri",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "catalog:",
		"next": "catalog:",
		"next-safe-action": "workspace:*",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"next": ">= 15.1.0",
		"next-safe-action": ">= 8.8.0"
	},
	"engines": {
		"node": ">=18.17"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/next-safe-action/next-safe-action.git",
		"directory": "packages/adapter-routes"
	},
	"publishConfig": {
		"access": "public"
	}
}
